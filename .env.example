# Copy to .env and adjust as needed:  cp .env.example .env

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=mathblasters
POSTGRES_PASSWORD=mathblasters
POSTGRES_DB=mathblasters
# Host port for the database. 5433 by default because a lot of machines
# already have something on 5432. Inside compose the API always uses db:5432.
POSTGRES_PORT=5433

# --- API ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
COOKIE_SECURE=false
# The rate limit applied to the completions endpoint
COMPLETIONS_RATE_LIMIT=20/minute

# GitHub OAuth Credentials (Local Dev Setup)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Credentials (Local Dev Setup)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth Flow Configuration
# Note: In non-development environments (e.g. staging, production), AUTH_SECRET_KEY must be set to a secure secret (min 32 chars).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENV=development
AUTH_SECRET_KEY=insecure-dev-secret-key-change-in-production
API_BASE_URL=http://localhost:8000
ALLOWED_POST_LOGIN_REDIRECTS=http://localhost:5173

# --- Frontend -------------------------------------------------------------
# Vite embeds this value into the shipped frontend at build time.
# For cross-origin production deployments, set VITE_API_URL during the production build.
# It is public and must never contain secrets.
VITE_API_URL=http://localhost:8000/api
