# Copy to .env and adjust as needed:  cp .env.example .env

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=mathblasters
POSTGRES_PASSWORD=mathblasters
POSTGRES_DB=mathblasters
# Host port for the database. 5433 by default because a lot of machines
# already have something on 5432. Inside compose the API always uses db:5432.
POSTGRES_PORT=5433

# --- API ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Frontend -------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
